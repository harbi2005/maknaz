# apps/api environment template. Copy to apps/api/.env (git-ignored). Placeholders only.
APP_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with credentials (the Vite dev server).
WEB_ORIGIN=http://localhost:5173
# Long random value; used to sign file download links. Generate one per environment.
APP_SECRET_KEY=change-me-locally

# PostgreSQL 16. `npm run db:start` launches a local server matching this URL.
DATABASE_URL=postgresql://maknaz:change-me@localhost:5433/maknaz
# Used by the API test suite (separate database, reset by the tests).
TEST_DATABASE_URL=postgresql://maknaz:change-me@localhost:5433/maknaz_test

# Platform admin created by `npm run db:seed` (never commit real credentials).
SEED_ADMIN_EMAIL=admin@maknaz.local
SEED_ADMIN_PASSWORD=change-me-admin-pass
# Seed clearly-labelled demo organizations, listings and carriers (BR-091).
DEMO_DATA_ENABLED=true
# Password given to every demo account created by the seed.
SEED_DEMO_PASSWORD=change-me-demo-pass

# Must stay "simulation" in the MVP: there is no real payment provider.
PAYMENTS_MODE=simulation
MEDIA_ROOT=./var/media
SIGNED_URL_TTL_SECONDS=300
# Background deadline processor interval (ms). Set to 0 to disable (tests run it manually).
SCHEDULER_INTERVAL_MS=60000
