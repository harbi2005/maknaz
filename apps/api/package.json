{
  "name": "@maknaz/api",
  "version": "0.1.0",
  "private": true,
  "description": "MAKNAZ REST API (Express + Prisma + PostgreSQL), modular monolith.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:start": "tsx --env-file-if-exists=.env scripts/local-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@maknaz/shared": "*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "16.15.0-beta.19",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
