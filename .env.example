# MAKNAZ — environment template.
# Copy to .env and fill locally. NEVER commit .env. All values below are placeholders.
# The application stack is not approved yet (OD-18); names follow the proposed Django + PostgreSQL setup.

# --- Core ---------------------------------------------------------------
APP_ENV=development                 # development | test | demo
APP_SECRET_KEY=change-me-locally    # generate a long random value per environment
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_TIME_ZONE_DISPLAY=Asia/Riyadh   # storage is always UTC

# --- Database (PostgreSQL 16) -------------------------------------------
DATABASE_URL=postgres://maknaz:change-me@localhost:5432/maknaz

# --- Simulation flags (must stay true in the MVP) -----------------------
PAYMENTS_MODE=simulation            # no real payment provider exists in the MVP
DEMO_DATA_ENABLED=true

# --- Email outbox (optional; console backend in development) ------------
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid

# --- File storage --------------------------------------------------------
MEDIA_ROOT=./var/media
SIGNED_URL_TTL_SECONDS=300
